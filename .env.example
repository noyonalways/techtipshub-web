BASE_API="your_base_api_url"
SITE_URL="your_site_url"
FACEBOOK_CLIENT_ID="your_facebook_client_id"
FACEBOOK_CLIENT_SECRET="your_facebook_client_secret"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CLIENT_ID="your_github_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
NEXTAUTH_SECRET="your_nextauth_secret"
# Public contact address shown on the contact page and legal pages.
NEXT_PUBLIC_CONTACT_EMAIL="contact.techtipshub@noyonrahman.com"
# Ad units render unless this is exactly "false". Set it to "false" to hide
# every ad frame locally; ads.txt and the loader stay untouched.
NEXT_PUBLIC_ADSENSE_ENABLED="true"